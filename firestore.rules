rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function role() { return me().role; }
    // A deactivated user (active == false) loses ALL access server-side, not just in the UI.
    function activeUser() { return me().get('active', true) != false; }
    function isAdmin() { return signedIn() && role() == 'ADMIN' && activeUser(); }
    function isStaff() { return signedIn() && role() in ['ADMIN','LEADER','OPERATOR'] && activeUser(); }

    // Users: self-create only as OPERATOR; only an active ADMIN may create other users or change role/active.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && ((request.auth.uid == uid && request.resource.data.role == 'OPERATOR') || isAdmin());
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role
        && request.resource.data.get('active', true) == resource.data.get('active', true));
      allow delete: if false;
    }
    // Master data and BOM: everyone staff reads, only ADMIN writes.
    match /{coll}/{id} {
      allow read: if isStaff() && coll in ['productCategories','supplyCategories','productionLines','operatorGroups','shifts','models','parts','bomHeaders','bomDetails','appSettings','productionBomSnapshots'];
      allow write: if isAdmin() && coll in ['productCategories','supplyCategories','productionLines','operatorGroups','shifts','models','parts','bomHeaders','bomDetails','appSettings'];
    }
    // Productions are scheduled by LEADER/ADMIN. Supply (OPERATOR) can only mark an ACTIVE production COMPLETED (status + updatedAt only).
    // Model and BOM version are immutable. Never deleted.
    match /productions/{id} {
      allow read: if isStaff();
      allow create: if leaderUp() && request.resource.data.status == 'ACTIVE' && request.resource.data.qty > 0 && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff() && request.resource.data.modelId == resource.data.modelId && request.resource.data.bomVersion == resource.data.bomVersion && request.resource.data.qty > 0
        && (leaderUp() || (resource.data.status == 'ACTIVE' && request.resource.data.status == 'COMPLETED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])));
      allow delete: if false;
    }
    match /productionBomSnapshots/{id} { allow create: if isStaff(); allow update, delete: if false; }
    function leaderUp() { return signedIn() && role() in ['ADMIN','LEADER'] && activeUser(); }
    function oldTaken() { return resource == null ? 0 : resource.data.taken; }
    // A running total may only change by EXACTLY the qty of a transaction/adjustment document created in the same commit.
    function totalsMove(coll, eid) {
      return !exists(/databases/$(db)/documents/$(coll)/$(eid))
        && existsAfter(/databases/$(db)/documents/$(coll)/$(eid))
        && getAfter(/databases/$(db)/documents/$(coll)/$(eid)).data.productionId == request.resource.data.productionId
        && getAfter(/databases/$(db)/documents/$(coll)/$(eid)).data.partId == request.resource.data.partId
        && math.abs(request.resource.data.taken - (oldTaken() + getAfter(/databases/$(db)/documents/$(coll)/$(eid)).data.qty)) < 0.000001;
    }
    // Transactions are append-only; corrections go to transactionAdjustments (leader/admin).
    match /supplyTransactions/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.operatorUid == request.auth.uid
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.shift in [1,2,3]
        && request.resource.data.type in ['TAKE_ALL','PARTIAL','OVER_SUPPLY']
        && get(/databases/$(db)/documents/productions/$(request.resource.data.productionId)).data.status == 'ACTIVE';
      allow update, delete: if false;
    }
    match /supplyTotals/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && id == request.resource.data.productionId + '_' + request.resource.data.partId
        && ((request.resource.data.lastKind == 'TX' && totalsMove('supplyTransactions', request.resource.data.lastId))
         || (request.resource.data.lastKind == 'ADJ' && isStaff() && totalsMove('transactionAdjustments', request.resource.data.lastId)));
      allow delete: if false;
    }
    function lpPath(txId) { return /databases/$(db)/documents/transactionAdjustments/$('lp_' + txId); }
    // REVERSAL: LEADER/ADMIN, reverses what is currently counted (recorded qty + loss-pack delta).
    // LOSS_PACK: any active staff, one per transaction (id lp_<txId>), note required, only if the transaction was not reversed.
    match /transactionAdjustments/{id} {
      allow read: if isStaff();
      allow create: if exists(/databases/$(db)/documents/supplyTransactions/$(request.resource.data.txId)) && (
        (leaderUp() && request.resource.data.type == 'REVERSAL' && request.resource.data.reason is string && request.resource.data.reason.size() > 2
          && id == 'rev_' + request.resource.data.txId
          && math.abs(request.resource.data.qty + get(/databases/$(db)/documents/supplyTransactions/$(request.resource.data.txId)).data.qty + (exists(lpPath(request.resource.data.txId)) ? get(lpPath(request.resource.data.txId)).data.qty : 0)) < 0.000001)
        || (isStaff() && request.resource.data.type == 'LOSS_PACK' && request.resource.data.note is string && request.resource.data.note.size() > 2
          && id == 'lp_' + request.resource.data.txId
          && !exists(/databases/$(db)/documents/transactionAdjustments/$('rev_' + request.resource.data.txId))
          && request.resource.data.qty is number && request.resource.data.qty != 0
          && request.resource.data.before.qty == get(/databases/$(db)/documents/supplyTransactions/$(request.resource.data.txId)).data.qty
          && request.resource.data.after.qty >= 0
          && math.abs(request.resource.data.after.qty - (request.resource.data.before.qty + request.resource.data.qty)) < 0.000001
          && request.resource.data.productionId == get(/databases/$(db)/documents/supplyTransactions/$(request.resource.data.txId)).data.productionId
          && request.resource.data.partId == get(/databases/$(db)/documents/supplyTransactions/$(request.resource.data.txId)).data.partId));
      allow update, delete: if false;
    }
    match /auditLogs/{id} { allow read: if isAdmin(); allow create: if isStaff(); allow update, delete: if false; }
  }
}
