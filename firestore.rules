rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'ADMIN'; }
    function isStaff() { return signedIn() && role() in ['ADMIN','LEADER','OPERATOR']; }

    // Users: self-create only as OPERATOR; role can only be changed by ADMIN.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'OPERATOR';
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }
    // Master data and BOM: everyone staff reads, only ADMIN writes.
    match /{coll}/{id} {
      allow read: if isStaff() && coll in ['productCategories','supplyCategories','productionLines','operatorGroups','shifts','models','parts','bomHeaders','bomDetails','appSettings','productionBomSnapshots'];
      allow write: if isAdmin() && coll in ['productCategories','supplyCategories','productionLines','operatorGroups','shifts','models','parts','bomHeaders','bomDetails','appSettings'];
    }
    // Productions: any staff may create/edit while ACTIVE; model and BOM version are immutable;
    // only ADMIN/LEADER may touch a COMPLETED/CANCELLED production (reopen). Never deleted.
    match /productions/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'ACTIVE' && request.resource.data.qty > 0 && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff() && request.resource.data.modelId == resource.data.modelId && request.resource.data.bomVersion == resource.data.bomVersion
        && request.resource.data.qty > 0 && (resource.data.status == 'ACTIVE' || role() in ['ADMIN','LEADER']);
      allow delete: if false;
    }
    match /productionBomSnapshots/{id} { allow create: if isStaff(); allow update, delete: if false; }
    // Transactions are append-only; corrections go to transactionAdjustments.
    match /supplyTransactions/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.operatorUid == request.auth.uid && request.resource.data.qty > 0;
      allow update, delete: if false;
    }
    match /supplyTotals/{id} { allow read: if isStaff(); allow create, update: if isStaff(); allow delete: if false; }
    match /transactionAdjustments/{id} { allow read: if isStaff(); allow create: if isStaff() && request.resource.data.reason is string; allow update, delete: if false; }
    match /auditLogs/{id} { allow read: if isAdmin(); allow create: if isStaff(); allow update, delete: if false; }
  }
}
